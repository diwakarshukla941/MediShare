# Render API service: medishare-api-staging
NODE_ENV=production
APP_ENV=staging
MONGODB_URI=<shared-mongodb-connection-string>
JWT_SECRET=<unique-long-random-staging-secret>
JWT_EXPIRES_IN=7d
STORAGE_CONFIG_ENCRYPTION_KEY=<same-stable-key-used-by-production>
CLIENT_URL=https://<your-staging-frontend-domain>

# Shared Cloudflare R2 credentials
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_ACCESS_KEY_ID=<shared-r2-access-key-id>
CLOUDFLARE_SECRET_ACCESS_KEY=<shared-r2-secret-access-key>
CLOUDFLARE_BUCKET_NAME=bonconnect
CLOUDFLARE_PUBLIC_DOMAIN=https://<shared-r2-public-domain>
CLOUDFLARE_FOLDER_PREFIX=bonconnect

# Render static site: medishare-client-staging (set these on the frontend service)
VITE_API_BASE_URL=https://<staging-api-domain>/api
VITE_APP_ENV=staging

# Only needed when creating the initial admin with the seed command
# ADMIN_NAME=<admin-name>
# ADMIN_EMAIL=<admin-email>
# ADMIN_PASSWORD=<strong-admin-password>
