# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Which environment this is: development | staging | production
# Purely for display/verification (GET /api/health echoes it back) — doesn't
# change app behavior. Set to "staging" on the staging Render service.
APP_ENV=development

# MongoDB — use a DIFFERENT database name per environment (e.g. medishare_dev,
# medishare_staging, medishare_production) on the same Atlas cluster, so
# staging/dev testing never touches production data.
MONGODB_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Encrypts cloud credentials saved through the Super Admin Storage & CDN page.
# Use a separate long random value in production. JWT_SECRET is used only as a
# legacy fallback when this is omitted.
STORAGE_CONFIG_ENCRYPTION_KEY=replace_with_a_second_long_random_string

# Single admin account (used by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKET_NAME=bonconnect
CLOUDFLARE_PUBLIC_DOMAIN=https://your-public-r2-domain.example.com
CLOUDFLARE_FOLDER_PREFIX=bonconnect

# Temporary: keep the old ImageKit endpoint only while running the one-time
# frame-asset migration, then remove it from the deployment environment.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
