# Only needed for production builds where the frontend and backend are
# separate hosted services on different domains. Leave unset for local dev —
# Vite's dev server proxies /api to the local server (see vite.config.js).
VITE_API_BASE_URL=https://your-backend-domain.example.com/api

# Which environment this build is: development | staging | production
# Shows a "STAGING"/"DEV" badge in the dashboard sidebar so it's never
# mistaken for production. Leave unset locally (defaults to "development").
VITE_APP_ENV=staging

