{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this stable: the existing Container application is named from this
  // Wrangler project name. Workers Builds overrides the deployed Worker name
  // to bonconnect-api, but changing this would create a conflicting Container.
  "name": "medishare-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "MediShareApiContainer",
      "image": "../../Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDISHARE_API",
        "class_name": "MediShareApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MediShareApiContainer"]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "VIDEO_RENDER_QUEUE", "queue": "bonconnect-video-renders" }
    ],
    "consumers": [
      {
        "queue": "bonconnect-video-renders",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "bonconnect-video-renders-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "APP_ENV": "production",
    "PORT": "8080",
    "JWT_EXPIRES_IN": "7d",
    "RENDER_JOBS_VIA_CLOUDFLARE_QUEUE": "true"
  }
}
